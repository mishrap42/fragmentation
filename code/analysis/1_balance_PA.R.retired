# ==============================================================================
# 1_balance_PA.R
# Creates area-weighted balance tables for protected vs unprotected cells
# Output: LaTeX booktabs tables to console
# ==============================================================================

library(data.table)
library(duckdb)
library(DBI)
library(Hmisc)
library(ggplot2)
library(countrycode)

# ------------------------------------------------------------------------------
# Setup paths
# ------------------------------------------------------------------------------

if (Sys.getenv("SLURM_SUBMIT_DIR") != "") {
  project_root <- Sys.getenv("SLURM_SUBMIT_DIR")
} else {
  project_root <- here::here()
}

data_dir <- file.path(project_root, "Data/build/final")
panel_path <- file.path(data_dir, "TMF_5km_panel.parquet")

cat("Loading data from:", panel_path, "\n")

# ------------------------------------------------------------------------------
# Load and prepare data (use DuckDB to handle large parquet files)
# ------------------------------------------------------------------------------

cat("Connecting to DuckDB and querying parquet...\n")
con <- dbConnect(duckdb())

# Query only year 2021 directly from parquet
query <- sprintf("SELECT * FROM read_parquet('%s') WHERE year = 2021", panel_path)
dt <- as.data.table(dbGetQuery(con, query))

dbDisconnect(con, shutdown = TRUE)
cat("Loaded", format(nrow(dt), big.mark = ","), "cells for year 2021\n")

gc()

print(head(dt))
print(colnames(dt))

# ------------------------------------------------------------------------------
# Define variables for balance table
# ------------------------------------------------------------------------------

# Variable definitions: list of (column_name, display_name, decimals)
vars <- list(
  # Geographic
  list("area_km2", "Cell Area (km$^2$)", 2),


  # Forest Cover (2021)
  list("Undisturbed_TMF", "Undisturbed TMF", 3),
  list("Degraded_TMF", "Degraded TMF", 3),
  list("Deforested", "Deforested", 3),
  list("forest_cover", "Forest Cover", 3),

  # Interior/Frontier
  list("is_interior", "Interior (prop.)", 3),
  list("is_frontier", "Frontier (prop.)", 3),
  list("dist_to_interior_km", "Dist. to Interior (km)", 1),
  list("signed_dist_to_frontier_km", "Signed Dist. to Frontier (km)", 1),

  # Accessibility
  list("travel_time_cities", "Travel Time to Cities (min)", 0),
  list("travel_time_ports", "Travel Time to Ports (min)", 0),
  list("dist_to_city_km", "Dist. to City (km)", 1),

  # Population
  list("pop_density_1990", "Pop. Density 1990", 1),
  list("pop_access_50km", "Pop. Access 50km", 1),

  # Biomass
  list("aboveground_biomass_carbon_2010", "Aboveground Biomass C", 1),
  list("belowground_biomass_carbon_2010", "Belowground Biomass C", 1),

  # Terrain
  list("elevation_m", "Elevation (m)", 0),
  list("slope_degrees", "Slope (degrees)", 2),
  list("terrain_ruggedness", "Terrain Ruggedness", 2),

  # Yields / cropland share (EarthStat, observed circa 2000). EarthStat reports
  # one realized yield per crop, so the GAEZ high-input vs rain-fed pair that
  # used to sit here collapses to a single column; the harvested-area fraction
  # is carried alongside it as the cropland-share measure.
  list("yield_maize", "Maize Yield (t/ha)", 2),
  list("cropshare_maize", "Maize Cropland Share", 3)
)

# ------------------------------------------------------------------------------
# Helper function: compute area-weighted mean
# ------------------------------------------------------------------------------

wtd_mean_safe <- function(x, w) {
  valid <- !is.na(x) & !is.na(w) & w > 0
  if (sum(valid) == 0) return(NA_real_)
  Hmisc::wtd.mean(x[valid], weights = w[valid])
}

# ------------------------------------------------------------------------------
# TABLE 1: Protected vs Unprotected
# ------------------------------------------------------------------------------

cat("\n\n")
cat("% ==============================================================================\n")
cat("% TABLE 1: Balance Table - Protected vs Unprotected (Year 2021)\n")
cat("% ==============================================================================\n\n")

# Split data
dt_prot <- dt[is_protected == TRUE]
dt_unprot <- dt[is_protected == FALSE]

n_prot <- nrow(dt_prot)
n_unprot <- nrow(dt_unprot)

# Build table rows
table1_lines <- c(
  "\\begin{tabular}{lrrrrr}",
  "\\toprule",
  "Variable & Protected & Unprotected & Diff. & N (P) & N (U) \\\\",
  "\\midrule"
)

for (v in vars) {
  col_name <- v[[1]]
  display_name <- v[[2]]
  decimals <- v[[3]]

  # Check if column exists

if (!(col_name %in% names(dt))) {
    warning(paste("Column not found:", col_name))
    next
  }

  # Convert logical to numeric for is_interior/is_frontier
  x_prot <- as.numeric(dt_prot[[col_name]])
  x_unprot <- as.numeric(dt_unprot[[col_name]])
  w_prot <- dt_prot$area_km2
  w_unprot <- dt_unprot$area_km2

  mean_prot <- wtd_mean_safe(x_prot, w_prot)
  mean_unprot <- wtd_mean_safe(x_unprot, w_unprot)
  diff_val <- mean_prot - mean_unprot

  # Count non-NA observations
  n_prot_var <- sum(!is.na(x_prot))
  n_unprot_var <- sum(!is.na(x_unprot))

  # Format values
  fmt <- paste0("%.", decimals, "f")
  mean_prot_str <- sprintf(fmt, mean_prot)
  mean_unprot_str <- sprintf(fmt, mean_unprot)
  diff_str <- sprintf(fmt, diff_val)

  row <- sprintf("%s & %s & %s & %s & %s & %s \\\\",
                 display_name,
                 mean_prot_str,
                 mean_unprot_str,
                 diff_str,
                 format(n_prot_var, big.mark = ","),
                 format(n_unprot_var, big.mark = ","))

  table1_lines <- c(table1_lines, row)
}

table1_lines <- c(table1_lines,
  "\\bottomrule",
  "\\end{tabular}"
)

cat(paste(table1_lines, collapse = "\n"))
cat("\n\n")

# ------------------------------------------------------------------------------
# TABLE 2: By IUCN Category (Wide Format)
# ------------------------------------------------------------------------------

cat("\n\n")
cat("% ==============================================================================\n")
cat("% TABLE 2: Balance Table by IUCN Category (Year 2021)\n")
cat("% ==============================================================================\n\n")

# Define IUCN categories (ordered)
iucn_cats <- c("Ia", "Ib", "II", "III", "IV", "V", "VI")

# Build table header
table2_lines <- c(
  "\\begin{tabular}{lrrrrrrrr}",
  "\\toprule",
  "Variable & Ia & Ib & II & III & IV & V & VI & Unprot. \\\\",
  "\\midrule"
)

for (v in vars) {
  col_name <- v[[1]]
  display_name <- v[[2]]
  decimals <- v[[3]]

  # Check if column exists
  if (!(col_name %in% names(dt))) {
    next
  }

  fmt <- paste0("%.", decimals, "f")

  # Calculate weighted mean for each IUCN category
  means <- character(length(iucn_cats))
  for (i in seq_along(iucn_cats)) {
    cat_i <- iucn_cats[i]
    dt_cat <- dt[iucn_cat == cat_i]

    if (nrow(dt_cat) > 0) {
      x_cat <- as.numeric(dt_cat[[col_name]])
      w_cat <- dt_cat$area_km2
      mean_cat <- wtd_mean_safe(x_cat, w_cat)
      means[i] <- sprintf(fmt, mean_cat)
    } else {
      means[i] <- "--"
    }
  }

  # Unprotected mean
  x_unprot <- as.numeric(dt_unprot[[col_name]])
  w_unprot <- dt_unprot$area_km2
  mean_unprot <- wtd_mean_safe(x_unprot, w_unprot)
  mean_unprot_str <- sprintf(fmt, mean_unprot)

  row <- sprintf("%s & %s & %s & %s & %s & %s & %s & %s & %s \\\\",
                 display_name,
                 means[1], means[2], means[3], means[4],
                 means[5], means[6], means[7],
                 mean_unprot_str)

  table2_lines <- c(table2_lines, row)
}

# Add observation counts row
n_row_parts <- character(length(iucn_cats))
for (i in seq_along(iucn_cats)) {
  n_cat <- nrow(dt[iucn_cat == iucn_cats[i]])
  n_row_parts[i] <- format(n_cat, big.mark = ",")
}

table2_lines <- c(table2_lines,
  "\\midrule",
  sprintf("N & %s & %s & %s & %s & %s & %s & %s & %s \\\\",
          n_row_parts[1], n_row_parts[2], n_row_parts[3], n_row_parts[4],
          n_row_parts[5], n_row_parts[6], n_row_parts[7],
          format(n_unprot, big.mark = ",")),
  "\\bottomrule",
  "\\end{tabular}"
)

cat(paste(table2_lines, collapse = "\n"))
cat("\n\n")

cat("% ==============================================================================\n")
cat("% END OF BALANCE TABLES\n")
cat("% ==============================================================================\n")

# ------------------------------------------------------------------------------
# FIGURE: Three-panel histogram of designation year (protected areas only)
# ------------------------------------------------------------------------------

cat("\n\nGenerating designation year histograms...\n")

# Filter to protected cells with desig_year >= 1991
dt_pa <- dt[is_protected == TRUE & !is.na(desig_year) & desig_year >= 1991]
cat("Protected cells with desig_year >= 1991:", format(nrow(dt_pa), big.mark = ","), "\n")

# Compute undisturbed forest area per cell (area_km2 * Undisturbed_TMF fraction)
dt_pa[, undisturbed_area_km2 := area_km2 * Undisturbed_TMF]

# Aggregate by designation year
# Panel 1: Number of unique PAs
pa_count <- dt_pa[, .(n_pas = uniqueN(wdpa_pid)), by = desig_year]

# Panel 2: Total area protected
area_by_year <- dt_pa[, .(total_area_km2 = sum(area_km2, na.rm = TRUE)), by = desig_year]

# Panel 3: Undisturbed forest area
undisturbed_by_year <- dt_pa[, .(undisturbed_area_km2 = sum(undisturbed_area_km2, na.rm = TRUE)), by = desig_year]

# Merge all into one data.table for plotting
plot_data <- merge(pa_count, area_by_year, by = "desig_year", all = TRUE)
plot_data <- merge(plot_data, undisturbed_by_year, by = "desig_year", all = TRUE)

# Convert to long format for faceted plotting
plot_long <- melt(plot_data, id.vars = "desig_year",
                  measure.vars = c("n_pas", "total_area_km2", "undisturbed_area_km2"),
                  variable.name = "metric", value.name = "value")

# Create nice labels for facets
plot_long[, metric_label := fcase(
  metric == "n_pas", "Number of Protected Areas",
  metric == "total_area_km2", "Total Area Protected (km\u00B2)",
  metric == "undisturbed_area_km2", "Undisturbed Forest Area (km\u00B2)"
)]

# Order factor for proper facet ordering
plot_long[, metric_label := factor(metric_label, levels = c(
  "Number of Protected Areas",
  "Total Area Protected (km\u00B2)",
  "Undisturbed Forest Area (km\u00B2)"
))]

# Create the plot
p <- ggplot(plot_long, aes(x = desig_year, y = value)) +
  geom_col(fill = "steelblue", width = 0.8) +
  facet_wrap(~ metric_label, ncol = 1, scales = "free_y") +
  scale_x_continuous(breaks = seq(1990, 2025, by = 5)) +
  scale_y_continuous(labels = scales::comma) +
  labs(
    x = "Designation Year",
    y = NULL,
    title = "Protected Area Designations by Year (1991+)",
    subtitle = "Based on 2021 cross-section of TMF panel"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    strip.text = element_text(face = "bold", size = 11),
    plot.title = element_text(face = "bold"),
    axis.text = element_text(size = 10)
  )

# Create output directory if it doesn't exist
fig_dir <- file.path(project_root, "output/figures/analysis")
if (!dir.exists(fig_dir)) {
  dir.create(fig_dir, recursive = TRUE)
  cat("Created directory:", fig_dir, "\n")
}

# Save figure
fig_path <- file.path(fig_dir, "pa_designation_year_histogram.png")
ggsave(fig_path, p, width = 8, height = 10, dpi = 300, bg = "white")
cat("Saved figure to:", fig_path, "\n")

# ------------------------------------------------------------------------------
# FIGURE 2: Stacked bars by Continent
# ------------------------------------------------------------------------------

cat("\nGenerating continent-stratified histograms...\n")

# Map country_iso3 to continent (tropical regions: Americas, Africa, Asia)
dt_pa[, continent := countrycode(country_iso3, "iso3c", "continent")]
dt_pa[, continent := fcase(
  continent == "Americas", "Americas",
  continent == "Africa", "Africa",
  continent %in% c("Asia", "Oceania"), "Asia-Pacific",
  default = "Other"
)]
dt_pa <- dt_pa[continent != "Other"]  # Keep only tropical continents

# Aggregate by desig_year and continent
agg_continent <- dt_pa[, .(
  n_pas = uniqueN(wdpa_pid),
  total_area_km2 = sum(area_km2, na.rm = TRUE),
  undisturbed_area_km2 = sum(undisturbed_area_km2, na.rm = TRUE)
), by = .(desig_year, continent)]

# Calculate shares within each year
agg_continent[, `:=`(
  n_pas_total = sum(n_pas),
  area_total = sum(total_area_km2),
  undisturbed_total = sum(undisturbed_area_km2)
), by = desig_year]

agg_continent[, `:=`(
  share_n = round(100 * n_pas / n_pas_total),
  share_area = round(100 * total_area_km2 / area_total),
  share_undisturbed = round(100 * undisturbed_area_km2 / undisturbed_total)
)]

# Melt for plotting
continent_long <- melt(agg_continent,
  id.vars = c("desig_year", "continent"),
  measure.vars = c("n_pas", "total_area_km2", "undisturbed_area_km2"),
  variable.name = "metric", value.name = "value")

share_long <- melt(agg_continent,
  id.vars = c("desig_year", "continent"),
  measure.vars = c("share_n", "share_area", "share_undisturbed"),
  variable.name = "share_metric", value.name = "share")

# Map share metrics to value metrics
share_long[, metric := fcase(
  share_metric == "share_n", "n_pas",
  share_metric == "share_area", "total_area_km2",
  share_metric == "share_undisturbed", "undisturbed_area_km2"
)]

continent_long <- merge(continent_long, share_long[, .(desig_year, continent, metric, share)],
  by = c("desig_year", "continent", "metric"))

continent_long[, metric_label := fcase(
  metric == "n_pas", "Number of Protected Areas",
  metric == "total_area_km2", "Total Area Protected (km\u00B2)",
  metric == "undisturbed_area_km2", "Undisturbed Forest Area (km\u00B2)"
)]
continent_long[, metric_label := factor(metric_label, levels = c(
  "Number of Protected Areas",
  "Total Area Protected (km\u00B2)",
  "Undisturbed Forest Area (km\u00B2)"
))]

# Continent colors
continent_colors <- c("Americas" = "#2E86AB", "Africa" = "#A23B72", "Asia-Pacific" = "#F18F01")

p2 <- ggplot(continent_long, aes(x = desig_year, y = value, fill = continent)) +
  geom_col(width = 0.8, position = "stack") +
  geom_text(aes(label = ifelse(share >= 5, paste0(share, "%"), "")),
            position = position_stack(vjust = 0.5), size = 2.5, color = "white", fontface = "bold") +
  facet_wrap(~ metric_label, ncol = 1, scales = "free_y") +
  scale_fill_manual(values = continent_colors, name = "Continent") +
  scale_x_continuous(breaks = seq(1990, 2025, by = 5)) +
  scale_y_continuous(labels = scales::comma) +
  labs(
    x = "Designation Year",
    y = NULL,
    title = "Protected Area Designations by Year and Continent (1991+)",
    subtitle = "Based on 2021 cross-section of TMF panel"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    strip.text = element_text(face = "bold", size = 11),
    plot.title = element_text(face = "bold"),
    axis.text = element_text(size = 10),
    legend.position = "bottom"
  )

fig_path2 <- file.path(fig_dir, "pa_designation_by_continent.png")
ggsave(fig_path2, p2, width = 8, height = 11, dpi = 300, bg = "white")
cat("Saved figure to:", fig_path2, "\n")

# ------------------------------------------------------------------------------
# FIGURE 3: Stacked bars by Zone (interior/frontier/other)
# ------------------------------------------------------------------------------

cat("\nGenerating zone-stratified histograms...\n")

# Aggregate by desig_year and zone
agg_zone <- dt_pa[, .(
  n_pas = uniqueN(wdpa_pid),
  total_area_km2 = sum(area_km2, na.rm = TRUE),
  undisturbed_area_km2 = sum(undisturbed_area_km2, na.rm = TRUE)
), by = .(desig_year, zone)]

# Calculate shares within each year
agg_zone[, `:=`(
  n_pas_total = sum(n_pas),
  area_total = sum(total_area_km2),
  undisturbed_total = sum(undisturbed_area_km2)
), by = desig_year]

agg_zone[, `:=`(
  share_n = round(100 * n_pas / n_pas_total),
  share_area = round(100 * total_area_km2 / area_total),
  share_undisturbed = round(100 * undisturbed_area_km2 / undisturbed_total)
)]

# Melt for plotting
zone_long <- melt(agg_zone,
  id.vars = c("desig_year", "zone"),
  measure.vars = c("n_pas", "total_area_km2", "undisturbed_area_km2"),
  variable.name = "metric", value.name = "value")

share_zone <- melt(agg_zone,
  id.vars = c("desig_year", "zone"),
  measure.vars = c("share_n", "share_area", "share_undisturbed"),
  variable.name = "share_metric", value.name = "share")

share_zone[, metric := fcase(
  share_metric == "share_n", "n_pas",
  share_metric == "share_area", "total_area_km2",
  share_metric == "share_undisturbed", "undisturbed_area_km2"
)]

zone_long <- merge(zone_long, share_zone[, .(desig_year, zone, metric, share)],
  by = c("desig_year", "zone", "metric"))

zone_long[, metric_label := fcase(
  metric == "n_pas", "Number of Protected Areas",
  metric == "total_area_km2", "Total Area Protected (km\u00B2)",
  metric == "undisturbed_area_km2", "Undisturbed Forest Area (km\u00B2)"
)]
zone_long[, metric_label := factor(metric_label, levels = c(
  "Number of Protected Areas",
  "Total Area Protected (km\u00B2)",
  "Undisturbed Forest Area (km\u00B2)"
))]

# Zone colors (green gradient for forest zones)
zone_colors <- c("interior" = "#1B4332", "frontier" = "#52B788", "other" = "#B7B7A4")

# Order zones
zone_long[, zone := factor(zone, levels = c("interior", "frontier", "other"))]

p3 <- ggplot(zone_long, aes(x = desig_year, y = value, fill = zone)) +
  geom_col(width = 0.8, position = "stack") +
  geom_text(aes(label = ifelse(share >= 5, paste0(share, "%"), "")),
            position = position_stack(vjust = 0.5), size = 2.5, color = "white", fontface = "bold") +
  facet_wrap(~ metric_label, ncol = 1, scales = "free_y") +
  scale_fill_manual(values = zone_colors, name = "Zone",
                    labels = c("interior" = "Interior", "frontier" = "Frontier", "other" = "Other")) +
  scale_x_continuous(breaks = seq(1990, 2025, by = 5)) +
  scale_y_continuous(labels = scales::comma) +
  labs(
    x = "Designation Year",
    y = NULL,
    title = "Protected Area Designations by Year and Forest Zone (1991+)",
    subtitle = "Based on 2021 cross-section of TMF panel"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    strip.text = element_text(face = "bold", size = 11),
    plot.title = element_text(face = "bold"),
    axis.text = element_text(size = 10),
    legend.position = "bottom"
  )

fig_path3 <- file.path(fig_dir, "pa_designation_by_zone.png")
ggsave(fig_path3, p3, width = 8, height = 11, dpi = 300, bg = "white")
cat("Saved figure to:", fig_path3, "\n")

# ------------------------------------------------------------------------------
# FIGURE 4: Cross-tabulation of Continent x Zone
# ------------------------------------------------------------------------------

cat("\nGenerating continent x zone summary...\n")

# Aggregate by continent and zone (totals, not by year)
cross_tab <- dt_pa[, .(
  n_pas = uniqueN(wdpa_pid),
  total_area_km2 = sum(area_km2, na.rm = TRUE),
  undisturbed_area_km2 = sum(undisturbed_area_km2, na.rm = TRUE)
), by = .(continent, zone)]

# Calculate shares
total_pas <- cross_tab[, sum(n_pas)]
total_area <- cross_tab[, sum(total_area_km2)]
total_undisturbed <- cross_tab[, sum(undisturbed_area_km2)]

cross_tab[, `:=`(
  share_n = round(100 * n_pas / total_pas),
  share_area = round(100 * total_area_km2 / total_area),
  share_undisturbed = round(100 * undisturbed_area_km2 / total_undisturbed)
)]

# Melt for plotting
cross_long <- melt(cross_tab,
  id.vars = c("continent", "zone"),
  measure.vars = c("n_pas", "total_area_km2", "undisturbed_area_km2"),
  variable.name = "metric", value.name = "value")

share_cross <- melt(cross_tab,
  id.vars = c("continent", "zone"),
  measure.vars = c("share_n", "share_area", "share_undisturbed"),
  variable.name = "share_metric", value.name = "share")

share_cross[, metric := fcase(
  share_metric == "share_n", "n_pas",
  share_metric == "share_area", "total_area_km2",
  share_metric == "share_undisturbed", "undisturbed_area_km2"
)]

cross_long <- merge(cross_long, share_cross[, .(continent, zone, metric, share)],
  by = c("continent", "zone", "metric"))

cross_long[, metric_label := fcase(
  metric == "n_pas", "Number of Protected Areas",
  metric == "total_area_km2", "Total Area Protected (km\u00B2)",
  metric == "undisturbed_area_km2", "Undisturbed Forest Area (km\u00B2)"
)]
cross_long[, metric_label := factor(metric_label, levels = c(
  "Number of Protected Areas",
  "Total Area Protected (km\u00B2)",
  "Undisturbed Forest Area (km\u00B2)"
))]

# Order zones
cross_long[, zone := factor(zone, levels = c("interior", "frontier", "other"))]

p4 <- ggplot(cross_long, aes(x = continent, y = value, fill = zone)) +
  geom_col(width = 0.7, position = "stack") +
  geom_text(aes(label = ifelse(share >= 1, paste0(share, "%"), "")),
            position = position_stack(vjust = 0.5), size = 3, color = "white", fontface = "bold") +
  facet_wrap(~ metric_label, ncol = 1, scales = "free_y") +
  scale_fill_manual(values = zone_colors, name = "Zone",
                    labels = c("interior" = "Interior", "frontier" = "Frontier", "other" = "Other")) +
  scale_y_continuous(labels = scales::comma) +
  labs(
    x = "Continent",
    y = NULL,
    title = "Protected Areas by Continent and Forest Zone (1991+)",
    subtitle = "Shares shown as % of global total within each metric"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    strip.text = element_text(face = "bold", size = 11),
    plot.title = element_text(face = "bold"),
    axis.text = element_text(size = 10),
    legend.position = "bottom"
  )

fig_path4 <- file.path(fig_dir, "pa_continent_zone_summary.png")
ggsave(fig_path4, p4, width = 8, height = 11, dpi = 300, bg = "white")
cat("Saved figure to:", fig_path4, "\n")

cat("\n=== All figures generated successfully ===\n")
